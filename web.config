<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <staticContent>
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>
		<security>
		  <requestFiltering>
			<!-- Increases the limit for the Request Filtering module -->
			<requestLimits maxQueryString="8192" />
		  </requestFiltering>
		 </security>
    </system.webServer>
	 <system.web>
		<!-- Increases the limit for the ASP.NET runtime -->
		<httpRuntime maxQueryStringLength="8192" />
	  </system.web>
</configuration>
